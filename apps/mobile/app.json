{
  "expo": {
    "name": "RonBri",
    "slug": "ronbri",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ronbri.app"
    },
    "android": {
      "package": "com.ronbri.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFF9F3"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "ronbri",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e9bb9021-a600-4084-96c0-d37cccd98403"
      }
    }
  }
}
