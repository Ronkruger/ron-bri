{
  "expo": {
    "name": "RonBri",
    "slug": "ronbri",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-photo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ronbri.app"
    },
    "android": {
      "package": "com.ronbri.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-photo.png",
        "backgroundColor": "#FFF9F3"
      },
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B98267",
          "defaultChannel": "messages"
        }
      ]
    ],
    "scheme": "ronbri",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e9bb9021-a600-4084-96c0-d37cccd98403"
      }
    }
  }
}
